# Production MIS Server Environment Configuration
PORT=5000

# Microsoft 365 SMTP Configuration. Set these on the server only. Do not commit the password.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Set to 1 when the site is served over HTTPS.
COOKIE_SECURE=1

# Optional Database (MySQL) Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=molding_mis_db
